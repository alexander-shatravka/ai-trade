// ============================================================================
//  AI TRADE v2.0 — Prisma schema
//  PostgreSQL 16 + pgvector
//
//  Конвенції:
//   • Усі гроші — Int у КОПІЙКАХ. Ніяких Float/Decimal у грошах.
//   • Усі id — cuid() (сортовані, коротші за uuid, не розкривають кількість записів).
//   • Часові поля — DateTime @db.Timestamptz(3).
//   • Soft delete через deletedAt там, де запис може знадобитись для аудиту.
//   • Поля з префіксом «// [Етап N]» — точки розширення поза MVP.
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearchPostgres"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector"), pg_trgm, unaccent, citext]
}

// ============================================================================
//  КОРИСТУВАЧІ ТА АВТЕНТИФІКАЦІЯ
// ============================================================================

enum UserRole {
  USER
  BUSINESS
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED   // тимчасове блокування модератором
  BANNED      // перманентне
  DELETED     // користувач видалив акаунт (GDPR): PII анонімізовано, зв'язки збережені
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique @db.Citext
  emailVerified DateTime? @db.Timestamptz(3)

  // Телефон верифікується перед першою публікацією — головний бар'єр проти шахраїв
  phone         String?   @unique
  phoneVerified DateTime? @db.Timestamptz(3)

  name       String?
  avatarUrl  String?
  bio        String?   @db.VarChar(500)
  locale     String    @default("uk")

  role   UserRole   @default(USER)
  status UserStatus @default(ACTIVE)

  // Гео за замовчуванням — для релевантності пошуку й рекомендацій
  cityId String?
  city   City?   @relation(fields: [cityId], references: [id], onDelete: SetNull)

  // Денормалізовані агрегати рейтингу (перераховуються при новому відгуку)
  ratingAvg          Float @default(0)   // 0.00–5.00
  ratingCount        Int   @default(0)
  successfulSales    Int   @default(0)
  avgResponseMinutes Int?                // для бейджа «Відповідає за N хв»

  lastSeenAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt  DateTime? @db.Timestamptz(3)

  accounts          Account[]
  sessions          Session[]
  listings          Listing[]
  media             Media[]
  subscription      Subscription?
  payments          Payment[]
  aiJobs            AiJob[]
  aiUsage           AiUsageCounter[]
  threadsAsBuyer    ChatThread[]     @relation("BuyerThreads")
  threadsAsSeller   ChatThread[]     @relation("SellerThreads")
  messages          ChatMessage[]
  reviewsWritten    Review[]         @relation("ReviewAuthor")
  reviewsReceived   Review[]         @relation("ReviewTarget")
  savedListings     SavedListing[]
  savedSearches     SavedSearch[]
  viewEvents        ViewEvent[]
  searchEvents      SearchEvent[]
  notifications     Notification[]
  reportsFiled      Report[]         @relation("Reporter")
  moderationActions ModerationAction[] @relation("Moderator")
  businessProfile   BusinessProfile?
  bulkImports       BulkImport[]
  valuations        Valuation[]
  promotions        Promotion[]
  auditLogs         AuditLog[]

  @@index([status, createdAt])
  @@index([cityId])
  @@index([ratingAvg(sort: Desc)])
  @@map("users")
}

/// OAuth-провайдери (Google) — сумісно з NextAuth-подібною моделлю
model Account {
  id                String  @id @default(cuid())
  userId            String
  provider          String  // "google"
  providerAccountId String
  accessToken       String? @db.Text
  refreshToken      String? @db.Text
  expiresAt         Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/// Refresh-токени з ротацією. Один рядок = одна активна сесія на пристрої.
model Session {
  id               String   @id @default(cuid())
  userId           String
  refreshTokenHash String   @unique     // зберігаємо ТІЛЬКИ хеш
  userAgent        String?
  ip               String?
  expiresAt        DateTime @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

/// Одноразові коди: magic-link, верифікація телефону, скидання email
model VerificationToken {
  id         String   @id @default(cuid())
  identifier String   // email або телефон
  tokenHash  String   @unique
  purpose    String   // "magic_link" | "phone_verify" | "email_change"
  expiresAt  DateTime @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  attempts   Int      @default(0)

  @@index([identifier, purpose])
  @@map("verification_tokens")
}

/// Сторінка магазину для тарифу BUSINESS
model BusinessProfile {
  id     String @id @default(cuid())
  userId String @unique

  slug        String  @unique          // /shop/avto-parts-kyiv
  companyName String
  description String? @db.Text
  logoUrl     String?
  bannerUrl   String?
  website     String?
  taxId       String?                  // ЄДРПОУ/ІПН — для верифікації бізнесу
  verified    Boolean @default(false)

  workingHours Json?                   // { mon: "09:00-18:00", ... }
  contactPhone String?

  /// Правила для AI-автовідповідача: доставка, оплата, гарантія, тон спілкування
  aiAssistantRules Json?
  aiAssistantEnabled Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("business_profiles")
}

// ============================================================================
//  ГЕОГРАФІЯ
// ============================================================================

model Region {
  id     String @id @default(cuid())
  name   String
  slug   String @unique
  cities City[]

  @@map("regions")
}

model City {
  id       String @id @default(cuid())
  regionId String
  name     String
  slug     String @unique
  lat      Float?
  lng      Float?
  population Int?

  region   Region    @relation(fields: [regionId], references: [id], onDelete: Cascade)
  users    User[]
  listings Listing[]

  @@index([regionId])
  @@index([name])
  @@map("cities")
}

// ============================================================================
//  КАТЕГОРІЇ
// ============================================================================

/// Дерево категорій (2 рівні на MVP, але модель довільної глибини).
/// attributeSchema — JSON Schema, за якою AI заповнює характеристики,
/// а фронтенд рендерить фільтри. Змінюється без міграцій.
model Category {
  id       String  @id @default(cuid())
  parentId String?
  slug     String  @unique
  name     String
  nameEn   String?
  icon     String?           // ключ іконки в дизайн-системі
  position Int     @default(0)
  isActive Boolean @default(true)

  /// JSON Schema характеристик категорії.
  /// Приклад: { "type":"object", "properties": {
  ///   "brand":  {"type":"string","title":"Бренд","x-filter":"facet"},
  ///   "storage":{"type":"integer","title":"Пам'ять, ГБ","x-filter":"range"} } }
  attributeSchema Json?

  /// Підказки для AI саме по цій категорії:
  /// на що звертати увагу на фото, які ракурси важливі, типові дефекти.
  aiHints Json?

  /// Медіанний час продажу та ціновий коридор — для швидких оцінок без запиту в LLM
  medianSellDays Int?
  priceP25Kop    Int?
  priceP50Kop    Int?
  priceP75Kop    Int?
  statsUpdatedAt DateTime? @db.Timestamptz(3)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  listings Listing[]

  @@index([parentId, position])
  @@map("categories")
}

// ============================================================================
//  ОГОЛОШЕННЯ
// ============================================================================

enum ListingStatus {
  DRAFT               // створене AI, ще не опубліковане
  PENDING_MODERATION
  ACTIVE
  REJECTED
  SOLD
  ARCHIVED            // знято користувачем
  EXPIRED             // 60 днів без продовження
}

enum ItemCondition {
  NEW
  LIKE_NEW
  GOOD
  ACCEPTABLE
  FOR_PARTS
}

enum PriceType {
  FIXED
  NEGOTIABLE
  FREE
  EXCHANGE            // [Етап 4] AI Exchange — поле є, UI за feature flag
}

model Listing {
  id     String @id @default(cuid())
  slug   String @unique               // "iphone-13-pro-128gb-graphite-c8f2"
  userId String

  title       String  @db.VarChar(70)
  description String  @db.Text
  categoryId  String

  /// Значення характеристик за attributeSchema категорії.
  /// JSONB + GIN-індекс → фільтрація без окремих таблиць на кожну категорію.
  attributes Json @default("{}")

  priceKop  Int                       // КОПІЙКИ
  currency  String    @default("UAH")
  priceType PriceType @default(FIXED)
  condition ItemCondition

  status         ListingStatus @default(DRAFT)
  rejectionReason String?      @db.Text

  cityId  String?
  lat     Float?
  lng     Float?

  // ── AI-походження ──────────────────────────────────────────────────────
  /// true, якщо основний контент згенеровано AI (для метрики North Star)
  aiGenerated Boolean @default(false)
  /// Які саме поля користувач залишив без правок. Ключова метрика якості AI.
  aiAcceptedFields String[] @default([])
  /// Впевненість розпізнавання (0–1). < 0.6 → показуємо попередження.
  aiConfidence Float?
  /// Прогноз ймовірності швидкого продажу (0–100) на момент публікації
  aiSellProbability Int?
  aiEstimatedSellDays Int?
  /// Три цінові сценарії від AI: { quickSaleKop, optimalKop, maximumKop, reasoning }
  aiPriceSuggestion Json?

  // ── Пошук ──────────────────────────────────────────────────────────────
  /// Ембеддинг (text-embedding-3-small, 1536). Індекс HNSW створюється в міграції:
  /// CREATE INDEX listings_embedding_idx ON listings
  ///   USING hnsw (embedding vector_cosine_ops) WITH (m=16, ef_construction=64);
  embedding Unsupported("vector(1536)")?
  /// tsvector, наповнюється тригером з title+description+attributes (конфіг 'ukrainian')
  searchVector Unsupported("tsvector")?
  keywords     String[] @default([])

  // ── Метрики ────────────────────────────────────────────────────────────
  viewsCount      Int @default(0)
  uniqueViewsCount Int @default(0)
  savesCount      Int @default(0)
  contactsCount   Int @default(0)   // скільки людей написали в чат
  impressionsCount Int @default(0)  // покази у видачі — знаменник для CTR

  // ── Просування ─────────────────────────────────────────────────────────
  promotedUntil DateTime? @db.Timestamptz(3)
  promotionTier PromotionTier?
  /// Обчислений буст ранжування (0–1), денормалізовано для швидкої сортировки
  boostScore Float @default(0)

  // ── Модерація ──────────────────────────────────────────────────────────
  /// AI-прескоринг ризику 0–1: <0.2 автопублікація, 0.2–0.7 черга, >0.7 блок
  riskScore     Float?
  moderatedAt   DateTime? @db.Timestamptz(3)
  moderatedById String?

  // ── [Етап 4] точки розширення: доставка / обмін ────────────────────────
  deliveryOptions   Json?
  exchangeAccepted  Boolean @default(false)

  publishedAt DateTime? @db.Timestamptz(3)
  soldAt      DateTime? @db.Timestamptz(3)
  expiresAt   DateTime? @db.Timestamptz(3)
  bumpedAt    DateTime? @db.Timestamptz(3)   // останнє підняття — впливає на freshness
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime? @db.Timestamptz(3)

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  city        City?         @relation(fields: [cityId], references: [id], onDelete: SetNull)
  media       Media[]
  aiJobs      AiJob[]
  advices     SellerAdvice[]
  threads     ChatThread[]
  saves       SavedListing[]
  views       ViewEvent[]
  stats       ListingDailyStat[]
  promotions  Promotion[]
  reports     Report[]
  valuations  Valuation[]
  reviews     Review[]
  bulkImportRow BulkImportRow?

  @@index([status, publishedAt(sort: Desc)])
  @@index([categoryId, status, priceKop])
  @@index([userId, status, createdAt(sort: Desc)])
  @@index([cityId, status])
  @@index([status, boostScore(sort: Desc), publishedAt(sort: Desc)])
  @@index([attributes], type: Gin)
  @@map("listings")
}

// ============================================================================
//  МЕДІА
// ============================================================================

enum MediaStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

model Media {
  id        String  @id @default(cuid())
  userId    String
  listingId String?

  status MediaStatus @default(UPLOADING)
  /// Ключ оригіналу в S3. Публічний URL віддається через CloudFront.
  storageKey String @unique
  mimeType   String
  sizeBytes  Int
  width      Int?
  height     Int?
  /// blurhash для миттєвого плейсхолдера — прибирає CLS у галереї
  blurhash   String?

  /// Згенеровані варіанти: { "320": {key,w,h}, "640": {...}, ..., "avif": {...} }
  variants Json?

  // ── AI-обробка фото ────────────────────────────────────────────────────
  bgRemovedKey  String?   // версія без фону
  enhancedKey   String?   // після upscale/корекції
  /// Що AI побачив на цьому фото: { angle: "front", defects: [...], quality: 0.82 }
  aiAnalysis    Json?
  /// Оцінка якості 0–1. Фото з < 0.4 позначаємо як «варто перезняти».
  qualityScore  Float?

  position  Int      @default(0)   // порядок у галереї; 0 = обкладинка
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, position])
  @@index([userId, createdAt(sort: Desc)])
  @@map("media")
}

// ============================================================================
//  AI: ДЖОБИ, АУДИТ, ВАРТІСТЬ
// ============================================================================

enum AiJobType {
  VISION_RECOGNIZE     // розпізнавання товару за фото
  COPY_GENERATE        // заголовок + опис + ключові слова
  PRICE_SUGGEST        // три цінові сценарії
  IMAGE_ENHANCE        // фон/якість
  LISTING_DIAGNOSE     // «чому не продається»
  SEARCH_PARSE         // NL → StructuredQuery
  CHAT_SUGGEST         // варіанти відповіді
  CHAT_AUTOREPLY       // автовідповідь BUSINESS
  EMBEDDING            // векторизація
  BULK_ENRICH          // збагачення рядка масового імпорту
  VALUATION_REPORT     // платна оцінка дорогого товару
  MODERATION_SCORE     // прескоринг ризику
}

enum AiJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  DEGRADED   // виконано мок-фолбеком через недоступність провайдера
}

/// Повний аудит кожного звернення до AI.
/// Потрібен для: біллінгу, розбору скарг, аналізу якості, донавчання промптів.
model AiJob {
  id        String @id @default(cuid())
  userId    String?
  listingId String?

  type   AiJobType
  status AiJobStatus @default(QUEUED)

  provider   String   // "openai" | "mock"
  model      String?  // "gpt-4o" | "gpt-4o-mini" | "text-embedding-3-small"
  promptVersion String? // "vision.recognize@v3" — щоб порівнювати якість між версіями

  input  Json?          // нормалізований вхід (без сирих base64 — тільки посилання на медіа)
  output Json?          // валідований вихід за JSON Schema
  error  String? @db.Text

  inputTokens  Int?
  outputTokens Int?
  /// Вартість у мікрокопійках (1 коп = 1000) — витрати на один виклик дрібні
  costMicroKop Int?
  latencyMs    Int?
  retryCount   Int @default(0)

  /// Кеш-хіт? Для аналізу економії
  cacheHit Boolean @default(false)

  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  listing Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([listingId, type])
  @@index([type, status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("ai_jobs")
}

/// Лічильники використання AI по періодах — швидка перевірка лімітів тарифу
/// без агрегації по ai_jobs (яка на мільйонах рядків буде повільною).
model AiUsageCounter {
  id     String @id @default(cuid())
  userId String
  /// Початок періоду (місяць): 2026-08-01T00:00:00Z
  period DateTime @db.Timestamptz(3)

  generationsUsed Int @default(0)   // AI-створення оголошень
  diagnosesUsed   Int @default(0)
  chatSuggestsUsed Int @default(0)
  bulkRowsUsed    Int @default(0)
  totalCostMicroKop BigInt @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
  @@index([period])
  @@map("ai_usage_counters")
}

/// Результат AI Seller Advisor — «чому не продається»
model SellerAdvice {
  id        String @id @default(cuid())
  listingId String

  /// Загальна оцінка «здоров'я» оголошення 0–100
  healthScore Int

  /// Знахідки по осях. Кожна:
  /// { axis:"price"|"photos"|"description"|"title"|"timing",
  ///   severity:"high"|"medium"|"low",
  ///   finding:"Ціна на 15% вище медіани",
  ///   evidence:{ medianKop, sampleSize, yourKop },
  ///   action:{ type:"set_price", valueKop: 2380000, label:"Знизити до 23 800 ₴" },
  ///   expectedEffect:"+65% ймовірності продажу за 14 днів" }
  findings Json

  /// Знімок ринку на момент аналізу — щоб порада була відтворюваною
  marketSnapshot Json?

  appliedAt DateTime? @db.Timestamptz(3)   // користувач застосував рекомендації
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, createdAt(sort: Desc)])
  @@map("seller_advices")
}

/// Платна AI-оцінка дорогих товарів
enum ValuationTier {
  FREE          // до 5 000 ₴
  STANDARD      // 5 000–50 000 ₴ · 99 ₴
  ADVANCED      // 50 000–200 000 ₴ · 299 ₴
  EXPERT        // 200 000+ ₴ · 499 ₴
}

model Valuation {
  id        String @id @default(cuid())
  userId    String
  listingId String?

  tier      ValuationTier
  priceKop  Int              // скільки коштувала сама оцінка
  paymentId String?

  /// { estimateKop, rangeKop:[min,max], comparables:[...], priceTrend6m:[...],
  ///   depreciationForecast:[...], bestSellWindow:"...", confidence:0.87 }
  report    Json?
  reportPdfKey String?       // згенерований PDF у S3

  status    String   @default("PENDING")  // PENDING | READY | FAILED
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@map("valuations")
}

// ============================================================================
//  ЧАТ
// ============================================================================

model ChatThread {
  id        String @id @default(cuid())
  listingId String
  buyerId   String
  sellerId  String

  lastMessageAt   DateTime? @db.Timestamptz(3)
  lastMessagePreview String? @db.VarChar(160)
  buyerUnread     Int @default(0)
  sellerUnread    Int @default(0)

  buyerArchived  Boolean @default(false)
  sellerArchived Boolean @default(false)
  /// Обидві сторони обмінялись повідомленнями → відкривається можливість відгуку
  mutualContact  Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  listing  Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer    User          @relation("BuyerThreads", fields: [buyerId], references: [id], onDelete: Cascade)
  seller   User          @relation("SellerThreads", fields: [sellerId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@unique([listingId, buyerId])          // один тред на пару листинг↔покупець
  @@index([buyerId, lastMessageAt(sort: Desc)])
  @@index([sellerId, lastMessageAt(sort: Desc)])
  @@map("chat_threads")
}

enum MessageType {
  TEXT
  IMAGE
  OFFER          // структурована пропозиція ціни
  SYSTEM         // «Оголошення продано», «Ціну знижено»
  AI_AUTOREPLY   // автовідповідь магазину (позначається в UI!)
}

model ChatMessage {
  id       String @id @default(cuid())
  threadId String
  senderId String

  type    MessageType @default(TEXT)
  body    String      @db.Text
  mediaKey String?
  /// Для type=OFFER: { amountKop, status: "pending"|"accepted"|"declined" }
  payload Json?

  /// Повідомлення згенеровано AI (підказка, яку користувач надіслав як є)
  aiGenerated Boolean @default(false)

  /// Результат модерації: { spam: 0.02, contactLeak: false, scam: 0.01 }
  moderationScore Json?
  isHidden Boolean @default(false)

  readAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User       @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@map("chat_messages")
}

// ============================================================================
//  ТАРИФИ, ПІДПИСКИ, ПЛАТЕЖІ
// ============================================================================

enum PlanCode {
  FREE
  PREMIUM
  BUSINESS
}

/// Тарифи в БД, а не в коді — щоб маркетинг міг змінювати ліміти й ціни
/// без релізу. Зміни версіонуються через priceKop-історію в Payment.
model Plan {
  id       String   @id @default(cuid())
  code     PlanCode @unique
  name     String
  priceKop Int                          // 0 / 19900 / 49900
  currency String   @default("UAH")

  maxActiveListings Int?                // null = безліміт
  maxAiGenerations  Int?
  features Json                          // { advisor:true, competitorAnalysis:true, ... }

  isActive  Boolean @default(true)
  position  Int     @default(0)

  subscriptions Subscription[]

  @@map("plans")
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE      // платіж не пройшов, є grace-період
  CANCELED      // скасовано, діє до кінця періоду
  EXPIRED
}

model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  planId String

  status SubscriptionStatus @default(ACTIVE)

  currentPeriodStart DateTime  @db.Timestamptz(3)
  currentPeriodEnd   DateTime  @db.Timestamptz(3)
  cancelAtPeriodEnd  Boolean   @default(false)
  canceledAt         DateTime? @db.Timestamptz(3)

  /// Токен рекурентного платежу провайдера (LiqPay/Fondy)
  providerCustomerId     String?
  providerSubscriptionId String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

enum PaymentPurpose {
  SUBSCRIPTION
  PROMOTION
  VALUATION
  // [Етап 4] ORDER, ESCROW — свідомо не в MVP
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id     String @id @default(cuid())
  userId String

  purpose PaymentPurpose
  amountKop Int
  currency  String @default("UAH")
  status    PaymentStatus @default(PENDING)

  provider          String  @default("liqpay")
  providerPaymentId String? @unique
  /// Сирий payload вебхука — для розборів зі службою підтримки й аудиту
  providerPayload   Json?

  /// [Етап 4] комісія платформи з угоди. На MVP завжди 0.
  feeKop Int @default(0)

  description String?
  failureReason String?

  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  succeededAt DateTime? @db.Timestamptz(3)
  refundedAt  DateTime? @db.Timestamptz(3)

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  promotions Promotion[]
  valuations Valuation[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("payments")
}

enum PromotionTier {
  START     // 99 ₴ / 7 днів
  PREMIUM   // 299 ₴ / 7 днів
  VIP       // 599 ₴ / 30 днів
}

model Promotion {
  id        String @id @default(cuid())
  listingId String
  userId    String
  paymentId String?

  tier      PromotionTier
  priceKop  Int
  startsAt  DateTime @db.Timestamptz(3)
  endsAt    DateTime @db.Timestamptz(3)
  isActive  Boolean  @default(true)

  /// Скільки показів/кліків дало просування — щоб продавець бачив ефект
  impressionsGained Int @default(0)
  viewsGained       Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  listing Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([listingId, isActive])
  @@index([isActive, endsAt])
  @@map("promotions")
}

// ============================================================================
//  МАСОВИЙ ІМПОРТ (BUSINESS)
// ============================================================================

enum BulkImportStatus {
  UPLOADED
  MAPPING       // користувач звіряє мапінг колонок
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

model BulkImport {
  id     String @id @default(cuid())
  userId String

  fileName   String
  fileKey    String            // Excel/CSV у S3
  photosKey  String?           // ZIP-архів фото
  status     BulkImportStatus @default(UPLOADED)

  /// Мапінг колонок файлу на поля листинга. AI пропонує, користувач підтверджує.
  columnMapping Json?

  totalRows     Int @default(0)
  processedRows Int @default(0)
  successRows   Int @default(0)
  errorRows     Int @default(0)

  errorReport Json?           // [{ row: 12, field: "price", message: "..." }]

  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  rows BulkImportRow[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("bulk_imports")
}

model BulkImportRow {
  id       String @id @default(cuid())
  importId String
  rowIndex Int

  rawData    Json                 // сирий рядок з файлу
  enrichedData Json?              // після AI-збагачення
  listingId  String? @unique      // створене оголошення
  status     String  @default("PENDING")  // PENDING | ENRICHED | CREATED | ERROR
  error      String?

  bulkImport BulkImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  listing    Listing?   @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@unique([importId, rowIndex])
  @@index([importId, status])
  @@map("bulk_import_rows")
}

// ============================================================================
//  ВІДГУКИ ТА РЕЙТИНГ
// ============================================================================

model Review {
  id       String @id @default(cuid())
  authorId String
  targetId String
  listingId String?

  rating  Int      @db.SmallInt      // 1–5
  comment String?  @db.VarChar(1000)
  /// Ролі: покупець оцінює продавця чи навпаки
  authorRole String                   // "buyer" | "seller"

  /// Відгук дозволений лише після mutualContact у треді — антинакрутка
  isVerified Boolean @default(false)
  isHidden   Boolean @default(false)

  reply     String?   @db.VarChar(1000)   // відповідь того, кого оцінили
  repliedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  author  User     @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  target  User     @relation("ReviewTarget", fields: [targetId], references: [id], onDelete: Cascade)
  listing Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@unique([authorId, listingId])    // один відгук на угоду
  @@index([targetId, createdAt(sort: Desc)])
  @@map("reviews")
}

// ============================================================================
//  ПОВЕДІНКА КОРИСТУВАЧА (для рекомендацій)
// ============================================================================

model SavedListing {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("saved_listings")
}

model SavedSearch {
  id     String @id @default(cuid())
  userId String

  name       String
  rawQuery   String?                    // «Ноутбук для ігор до 30000 грн»
  structured Json                        // розпарсений StructuredQuery
  notifyEmail Boolean @default(true)
  lastNotifiedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_searches")
}

/// Події переглядів. Партиціонується по місяцях у міграції (PARTITION BY RANGE).
model ViewEvent {
  id        String   @id @default(cuid())
  listingId String
  userId    String?
  sessionId String?                     // анонімні користувачі
  source    String?                     // "search" | "recommendation" | "category" | "direct"
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([listingId, createdAt])
  @@index([userId, createdAt(sort: Desc)])
  @@map("view_events")
}

model SearchEvent {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String?
  rawQuery  String
  structured Json?
  resultsCount Int
  clickedListingId String?
  /// Чи використовувався LLM-парсинг, чи фолбек
  usedAi    Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt])
  @@map("search_events")
}

/// Передагреговані денні метрики — для графіків у кабінеті без сканування ViewEvent
model ListingDailyStat {
  id        String   @id @default(cuid())
  listingId String
  date      DateTime @db.Date

  views       Int @default(0)
  uniqueViews Int @default(0)
  impressions Int @default(0)
  saves       Int @default(0)
  contacts    Int @default(0)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, date])
  @@index([date])
  @@map("listing_daily_stats")
}

// ============================================================================
//  МОДЕРАЦІЯ ТА СКАРГИ
// ============================================================================

enum ReportReason {
  PROHIBITED_ITEM
  FRAUD
  SPAM
  WRONG_CATEGORY
  OFFENSIVE
  DUPLICATE
  AI_INACCURACY      // «AI написав неправду про товар» — окрема категорія, важлива для нас
  OTHER
}

model Report {
  id         String @id @default(cuid())
  reporterId String?
  listingId  String?
  messageId  String?

  reason  ReportReason
  comment String? @db.VarChar(1000)
  status  String  @default("OPEN")   // OPEN | REVIEWING | RESOLVED | DISMISSED

  resolvedAt DateTime? @db.Timestamptz(3)
  resolution String?   @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  reporter User?    @relation("Reporter", fields: [reporterId], references: [id], onDelete: SetNull)
  listing  Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([listingId])
  @@map("reports")
}

model ModerationAction {
  id          String @id @default(cuid())
  moderatorId String

  targetType String        // "listing" | "user" | "message" | "review"
  targetId   String
  action     String        // "approve" | "reject" | "suspend" | "ban" | "hide"
  reason     String?  @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  moderator User @relation("Moderator", fields: [moderatorId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@index([moderatorId, createdAt(sort: Desc)])
  @@map("moderation_actions")
}

// ============================================================================
//  СПОВІЩЕННЯ ТА АУДИТ
// ============================================================================

enum NotificationType {
  NEW_MESSAGE
  LISTING_APPROVED
  LISTING_REJECTED
  LISTING_EXPIRING
  ADVICE_READY          // «AI знає, чому ваш товар не продається»
  PRICE_DROP_SUGGESTED
  SAVED_SEARCH_MATCH
  REVIEW_RECEIVED
  SUBSCRIPTION_RENEWED
  SUBSCRIPTION_FAILED
  PROMOTION_ENDING
  VALUATION_READY
}

model Notification {
  id     String @id @default(cuid())
  userId String

  type    NotificationType
  title   String
  body    String?  @db.Text
  linkUrl String?
  payload Json?

  readAt    DateTime? @db.Timestamptz(3)
  emailSentAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

/// Аудит адміністративних і чутливих дій. Тільки append, ніколи не оновлюється.
model AuditLog {
  id     String @id @default(cuid())
  userId String?

  action     String   // "user.ban" | "plan.update" | "listing.force_delete" | "ai.prompt_change"
  entityType String?
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

/// Feature flags у БД — вмикання/вимикання відкладеного функціоналу без релізу
model FeatureFlag {
  key         String  @id
  enabled     Boolean @default(false)
  description String?
  /// Відсоток користувачів (0–100) для поетапного розкату
  rolloutPercent Int  @default(0)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@map("feature_flags")
}
